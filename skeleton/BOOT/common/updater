#!/bin/sh

# NOTE: becomes .tmp_update/updater

LOG_FILE="/mnt/SDCARD/cannelloni_install.log"
log() {
	echo "$@"
	echo "$@" >> "$LOG_FILE" 2>/dev/null
	sync
}

log "=== [$(date +'%Y-%m-%d %H:%M:%S')] .tmp_update/updater triggered ==="
log "updater PWD: $(pwd)"

INFO=`cat /proc/cpuinfo 2> /dev/null`
log "updater CPU Info: $(echo "$INFO" | grep -iE 'hardware|model|processor|cortex|arm' | tr '\n' ' ')"

case $INFO in
*"sun8i"*)
	if [ -d /usr/miyoo ]; then
		PLATFORM="my282" # Miyoo A30
	else
		PLATFORM="trimuismart"
	fi
	;;
*"SStar"*|*"sstar"*|*"Sigmastar"*|*"SigmaStar"*|*"SSD20"*|*"infinity2"*|*"Infinity2"*|*"MStar"*)
	PLATFORM="miyoomini"
	;;
*"TG5040"*|*"TG3040"*)
	PLATFORM="tg5040" # Trimui Smart Pro or Brick
	;;
*"0xd03"*)
	PLATFORM="zero28" # MagicX Mini Zero 28
	;;
*"0xd05"*)
	PLATFORM="my355" # Miyoo Flip
	;;
*)
	if [ -f "/customer/app/axp_test" ] || [ -d "/customer/app" ]; then
		PLATFORM="miyoomini"
	fi
	;;
esac

# fallback for tg5040 20240413 recovery firmware
if [ -z "$PLATFORM" ] && [ -f /usr/trimui/bin/runtrimui.sh ]; then
	PLATFORM="tg5040"
fi

log "updater resolved PLATFORM: '$PLATFORM'"

TARGET_SCRIPT="/mnt/SDCARD/.tmp_update/$PLATFORM.sh"
[ ! -f "$TARGET_SCRIPT" ] && TARGET_SCRIPT="$(dirname "$0")/$PLATFORM.sh"
log "Checking target script: $TARGET_SCRIPT (exists: $([ -f "$TARGET_SCRIPT" ] && echo YES || echo NO))"

if [ -n "$PLATFORM" ] && [ -f "$TARGET_SCRIPT" ]; then
	chmod +x "$TARGET_SCRIPT" 2>/dev/null
	log "Executing $TARGET_SCRIPT..."
	exec "$TARGET_SCRIPT"
else
	log "ERROR: Target script not found or PLATFORM is empty ('$PLATFORM')!"
fi
