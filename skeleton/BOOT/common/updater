#!/bin/sh

# NOTE: becomes .tmp_update/updater

LOG_FILE="/mnt/SDCARD/cannelloni_install.log"
echo "=== [$(date +'%Y-%m-%d %H:%M:%S')] .tmp_update/updater triggered ===" >> "$LOG_FILE" 2>&1
echo "updater PWD: $(pwd)" >> "$LOG_FILE" 2>&1

INFO=`cat /proc/cpuinfo 2> /dev/null`
echo "updater CPU Info: $(echo "$INFO" | grep -iE 'hardware|model|processor|cortex|arm' | tr '\n' ' ')" >> "$LOG_FILE" 2>&1
sync

case $INFO in
*"sun8i"*)
	if [ -d /usr/miyoo ]; then
		PLATFORM="my282" # Miyoo A30
	else
		PLATFORM="trimuismart"
	fi
	;;
*"SStar"*|*"sstar"*|*"Sigmastar"*|*"SigmaStar"*|*"SSD20"*|*"infinity2"*|*"Infinity2"*|*"MStar"*)
	PLATFORM="miyoomini"
	;;
*"TG5040"*|*"TG3040"*)
	PLATFORM="tg5040" # Trimui Smart Pro or Brick
	;;
*"0xd03"*)
	PLATFORM="zero28" # MagicX Mini Zero 28
	;;
*"0xd05"*)
	PLATFORM="my355" # Miyoo Flip
	;;
*)
	if [ -f "/customer/app/axp_test" ] || [ -d "/customer/app" ]; then
		PLATFORM="miyoomini"
	fi
	;;
esac

# fallback for tg5040 20240413 recovery firmware
if [ -z "$PLATFORM" ] && [ -f /usr/trimui/bin/runtrimui.sh ]; then
	PLATFORM="tg5040"
fi

echo "updater resolved PLATFORM: '$PLATFORM'" >> "$LOG_FILE" 2>&1

TARGET_SCRIPT="/mnt/SDCARD/.tmp_update/$PLATFORM.sh"
echo "Checking target script: $TARGET_SCRIPT (exists: $([ -f "$TARGET_SCRIPT" ] && echo YES || echo NO))" >> "$LOG_FILE" 2>&1
sync

if [ -n "$PLATFORM" ] && [ -f "$TARGET_SCRIPT" ]; then
	chmod +x "$TARGET_SCRIPT" 2>/dev/null
	echo "Executing $TARGET_SCRIPT..." >> "$LOG_FILE" 2>&1
	sync
	exec "$TARGET_SCRIPT"
else
	echo "ERROR: Target script not found or PLATFORM is empty ('$PLATFORM')!" >> "$LOG_FILE" 2>&1
	sync
fi
